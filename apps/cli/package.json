{
  "name": "@petty/cli",
  "version": "1.5.17",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/WawRepo/petty.git"
  },
  "private": true,
  "type": "module",
  "bin": {
    "petty": "./src/bin.ts"
  },
  "scripts": {
    "start": "tsx src/bin.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "AUTH_PROVIDER=local vitest run",
    "bundle": "esbuild src/bin.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/petty.mjs --legal-comments=eof --metafile=meta.json --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\"",
    "pack": "pnpm run bundle && tsx ../../scripts/bundle-notices.ts --meta meta.json --what \"petty, the Petty command line\" --bundle dist/petty.mjs && mkdir -p ../web/public/downloads && cp dist/petty.mjs ../web/public/downloads/petty.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@petty/agent": "workspace:*",
    "@petty/crypto": "workspace:*",
    "@petty/ledger": "workspace:*",
    "@petty/mcp": "workspace:*",
    "@petty/protocol": "workspace:*"
  },
  "devDependencies": {
    "@petty/api": "workspace:*",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15"
  }
}
