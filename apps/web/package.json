{
  "name": "@petty/web",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "tsx scripts/icons.ts",
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc -p tsconfig.json && vite build && tsx scripts/sri.ts && tsx scripts/precompress.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "preview": "vite preview --port 4173 --strictPort",
    "preview:prod": "cd ../api && API_PORT=3100 API_PREFIX=/api WEB_DIST=../web/dist pnpm start"
  },
  "dependencies": {
    "@clerk/clerk-js": "5.127.2",
    "@clerk/clerk-react": "^5.61.9",
    "@petty/crypto": "workspace:*",
    "@petty/ledger": "workspace:*",
    "@petty/protocol": "workspace:*",
    "i18next": "^25.5.2",
    "i18next-icu": "^2.4.4",
    "intl-messageformat": "^10.7.16",
    "lucide-react": "^1.45.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^15.7.3",
    "react-router": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@clerk/testing": "^2.2.34",
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "pg": "^8.16.3",
    "sharp": "~0.35.4",
    "tsx": "^4.20.5",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.0.3"
  }
}
