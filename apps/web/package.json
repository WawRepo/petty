{
  "name": "@petty/web",
  "version": "1.5.20",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/WawRepo/petty.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "tsx scripts/icons.ts",
    "dev": "vite --port 5173 --strictPort",
    "build": "tsx scripts/notices.ts && tsc -p tsconfig.json && vite build && tsx scripts/sri.ts && tsx scripts/precompress.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "preview": "vite preview --port 4173 --strictPort",
    "preview:prod": "cd ../api && API_PORT=3100 API_PREFIX=/api WEB_DIST=../web/dist pnpm start"
  },
  "dependencies": {
    "@clerk/clerk-js": "6.39.0",
    "@clerk/localizations": "4.23.0",
    "@clerk/react": "^6.17.8",
    "@clerk/ui": "1.40.0",
    "@petty/crypto": "workspace:*",
    "@petty/ledger": "workspace:*",
    "@petty/protocol": "workspace:*",
    "i18next": "^26.4.3",
    "i18next-icu": "^2.5.0",
    "intl-messageformat": "^12.1.3",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-router": "^8.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@clerk/testing": "^2.2.45",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "pg": "^8.23.1",
    "sharp": "~0.35.5",
    "tsx": "^4.23.15",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  }
}
