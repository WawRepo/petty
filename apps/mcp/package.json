{
  "name": "@petty/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "petty-mcp": "./src/bin.ts"
  },
  "scripts": {
    "start": "tsx src/bin.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "AUTH_PROVIDER=local vitest run",
    "bundle": "esbuild src/bin.ts --bundle --platform=node --format=esm --target=node20 --outfile=mcpb/server/index.mjs --legal-comments=none --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\"",
    "pack": "pnpm run bundle && mcpb validate mcpb/manifest.json && mkdir -p ../web/public/downloads && mcpb pack mcpb ../web/public/downloads/petty.mcpb && cp mcpb/server/index.mjs ../web/public/downloads/petty-mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@petty/agent": "workspace:*",
    "zod": "^3.25.76",
    "@petty/ledger": "workspace:*"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@petty/api": "workspace:*",
    "@petty/crypto": "workspace:*",
    "@petty/protocol": "workspace:*",
    "@types/node": "^22.17.2",
    "esbuild": "0.28.2",
    "tsx": "^4.20.5"
  }
}
