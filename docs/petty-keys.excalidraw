   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Green = your device, memory only (never on disk).  Yellow = a secret made on your device.  Grey = server database (locked blobs + metadata only).  Blue = a member's device.",
   "fontSize": 13,
