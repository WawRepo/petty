      "updated": 1789944405078,
      "link": null,
      "locked": false,
      "text": "A token is weaker than a session.\nIt can never open the vault, the account,\nsharing, admin, export, or make another token.\nThe server refuses every route off its list.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "d3982fd9",
      "originalText": "A token is weaker than a session.\nIt can never open the vault, the account,\nsharing, admin, export, or make another token.\nThe server refuses every route off its list.",
      "autoResize": false,
      "lineHeight": 1.25,
      "index": "b0D"
