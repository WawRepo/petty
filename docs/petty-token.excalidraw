      "updated": 1789944405078,
      "link": null,
      "locked": false,
      "text": "Holds the token string. Sends only:\nAuthorization: Bearer petty_pat_<id>\n(the secret half stays on this machine)",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "9ea187d7",
      "originalText": "Holds the token string. Sends only:\nAuthorization: Bearer petty_pat_<id>\n(the secret half stays on this machine)",
