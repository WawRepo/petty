      "boundElements": [],
      "updated": 1789944405078,
      "link": null,
      "locked": false,
      "text": "Revoke: the id stops working at once.\nAccount delete ERASES the bundle and the wraps,\nbut keeps the public delegation, so entries the\ntoken already wrote still verify for everyone.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "6cd3e5a3",
      "originalText": "Revoke: the id stops working at once.\nAccount delete ERASES the bundle and the wraps,\nbut keeps the public delegation, so entries the\ntoken already wrote still verify for everyone.",
      "autoResize": false,
      "lineHeight": 1.25,
      "index": "b0A"
    },
