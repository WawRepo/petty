      "updated": 1789944405078,
      "link": null,
      "locked": false,
      "text": "A member's app checks a token-signed\nentry through the account-signed\ndelegation: accepted only while the\ntoken has not expired or been revoked.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "e5ca3c30",
      "originalText": "A member's app checks a token-signed\nentry through the account-signed\ndelegation: accepted only while the\ntoken has not expired or been revoked.",
      "autoResize": false,
      "lineHeight": 1.25,
      "index": "b08"
    },
