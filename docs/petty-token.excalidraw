      "updated": 1789944405078,
      "link": null,
      "locked": false,
      "text": "2  THE TOOL USES IT  (petty-mcp / the agent, on your computer)",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "originalText": "2  THE TOOL USES IT  (petty-mcp / the agent, on your computer)",
