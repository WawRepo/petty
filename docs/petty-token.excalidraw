      "boundElements": [],
      "updated": 1789944405078,
      "link": null,
      "locked": false,
      "text": "petty_pat_<id>.<secret>\nShown once. You paste it into the tool.\n<id> = names the token to the server\n<secret> = opens the bundle, on this machine",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "e66e9991",
      "originalText": "petty_pat_<id>.<secret>\nShown once. You paste it into the tool.\n<id> = names the token to the server\n<secret> = opens the bundle, on this machine",
      "autoResize": false,
      "lineHeight": 1.25,
      "index": "aY"
    },
    {
      "id": "746911c2",
      "type": "text",
      "x": 40,
      "y": 545,
      "width": 815.1,
      "height": 16.25,
      "angle": 0,
      "strokeColor": "#8a6d1f",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1178954507,
      "version": 2,
      "versionNonce": 711409098,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789944405078,
      "link": null,
      "locked": false,
      "text": "The server stores a locked bundle and an id hash. Without the secret it cannot open the bundle or read any drawer.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "originalText": "The server stores a locked bundle and an id hash. Without the secret it cannot open the bundle or read any drawer.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "aZ",
      "containerId": null
    },
