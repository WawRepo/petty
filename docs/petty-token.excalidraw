      "updated": 1789944405078,
      "link": null,
      "locked": false,
      "text": "Same promise as a person's keys: the plaintext lives only on a machine that holds the secret. The server, and anyone who reads its database, sees ciphertext.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "originalText": "Same promise as a person's keys: the plaintext lives only on a machine that holds the secret. The server, and anyone who reads its database, sees ciphertext.",
