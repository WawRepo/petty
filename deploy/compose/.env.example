# Copy to deploy/compose/.env and fill in. Never commit the filled file.
# Three different long random passwords of letters and digits only: they go into postgres://
# addresses, where / ? # @ : break them. For example: openssl rand -hex 32
OWNER_DB_PASSWORD=
API_DB_PASSWORD=
MAINT_DB_PASSWORD=
# The public HTTPS address of your Petty (used in emailed links)
APP_URL=https://petty.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Petty <petty@example.com>
# Where "Get an invite" sends email; empty hides the link
CONTACT_EMAIL=
# The proxies whose X-Forwarded-For the app believes. The default trusts proxies on private networks,
# which is where your reverse proxy connects from; behind a CDN, add its ranges (docs/deploy.md).
TRUST_PROXY=loopback,linklocal,uniquelocal
# Behind a platform or CDN that sets its own client-address header, name it here (Cloudflare:
# CF-Connecting-IP). Only if the app can be reached through that proxy alone. Empty = none.
CLIENT_IP_HEADER=
# Image, pinned by tag AND digest: docker buildx imagetools inspect ghcr.io/wawrepo/petty:<tag>
PETTY_IMAGE=ghcr.io/wawrepo/petty:<tag>@sha256:<digest>
# local (default) or clerk; see docs/auth-clerk.md
AUTH_PROVIDER=local
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_FRONTEND_API=
CLERK_JWT_KEY=
# Clerk mode: origins whose sign-ins are accepted; empty = the origin of APP_URL
CLERK_AUTHORIZED_PARTIES=
# Local mode only: true = anyone can create an account without a join link (a public instance).
# Default (empty) = invite-only; mint the first account with the join-link script, see docs/deploy.md.
OPEN_SIGNUP=
# Per-person storage limit in MB: photos, documents and entries in the drawers a person owns
# (a member's writes count against the drawer's owner). Empty = no limit, fine for a household.
STORAGE_QUOTA_MB=
# Telemetry, see docs/monitoring.md. OTLP/HTTP endpoint (traces always push when set);
# OTEL_PUSH=true also pushes metrics + logs to it; DEPLOYMENT_ENV tags every signal (e.g. home, public).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Env-format pair for the endpoint's auth, e.g. Authorization=Basic <token>; empty for an in-network collector
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_PUSH=
DEPLOYMENT_ENV=
# Prometheus /metrics port inside the container (0 = off). Not published by this compose file.
METRICS_PORT=0
LOG_LEVEL=info
