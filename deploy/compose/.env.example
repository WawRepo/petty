# Copy to deploy/compose/.env and fill in. Never commit the filled file.
# Three different long random passwords, for example: openssl rand -base64 32
OWNER_DB_PASSWORD=
API_DB_PASSWORD=
MAINT_DB_PASSWORD=
# The public HTTPS address of your Petty (used in emailed links)
APP_URL=https://petty.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Petty <petty@example.com>
# Where "Get an invite" sends email; empty hides the link
CONTACT_EMAIL=
# Image version; pin a tag or a digest in production
PETTY_TAG=latest
# local (default) or clerk; see docs/auth-clerk.md
AUTH_PROVIDER=local
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_FRONTEND_API=
CLERK_JWT_KEY=
