# The one place for local settings: copy to .env at the repo root (gitignored). The API dev
# server, the tests and docker compose all read it; a variable already in the environment wins.
# Defaults below match docker-compose.yml; everything is optional.
PGHOST=localhost
PGPORT=5432
PGDATABASE=petty
# Migration owner (creates tables, grants). Never used by the running API.
DATABASE_URL=postgres://petty:petty@localhost:5432/petty
# Request role: SELECT/INSERT only on entries.
API_DATABASE_URL=postgres://petty_api:petty_api@localhost:5432/petty
# Maintenance role: rotation and line/drawer deletion only.
MAINT_DATABASE_URL=postgres://petty_maint:petty_maint@localhost:5432/petty
API_PORT=3000
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Identity provider (PETTY-88, docs/auth-clerk.md) ---
# local = Petty's own login (default). clerk = Clerk holds identity; the vault stays here.
AUTH_PROVIDER=local
# From dashboard.clerk.com -> API keys. The publishable key reaches the web app through GET /config.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Where "Get an invite" sends email (empty hides the link)
CONTACT_EMAIL=
# A folder with the operator's privacy.<lang>.md and terms.<lang>.md (docs/deploy.md); empty = none
LEGAL_DIR=
# The Clerk frontend API origin (https://<slug>.clerk.accounts.dev in development), for the CSP.
CLERK_FRONTEND_API=
# Optional: the PEM public key from the dashboard for networkless token verification.
CLERK_JWT_KEY=
