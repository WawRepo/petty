{
  "name": "petty",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/WawRepo/petty.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "pnpm --filter @petty/api --filter @petty/web --parallel run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "test": "pnpm -r run test",
    "migrate": "pnpm --filter @petty/api run migrate",
    "seed": "pnpm --filter @petty/api run seed",
    "i18n:check": "pnpm --filter @petty/web i18n:check",
    "e2e": "pnpm --filter @petty/web e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "eslint": "^9.34.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.42.0",
    "vitest": "^4.1.11"
  }
}
